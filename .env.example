# Variables d'environnement à renseigner dans Coolify (onglet « Environment Variables »)
# --- OBLIGATOIRES ---------------------------------------------------------
# Clé secrète Django : générez-en une longue et gardez-la STABLE
# (si elle change, tous les utilisateurs sont déconnectés). Exemple pour en générer une :
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
GE_SECRET_KEY=REMPLACEZ_PAR_UNE_CLE_LONGUE_ET_SECRETE

# Production : désactive le mode debug.
GE_DEBUG=0

# Domaine(s) autorisé(s), séparés par des virgules.
GE_ALLOWED_HOSTS=gemining.duckdns.org

# Origines de confiance pour le CSRF (avec https://).
GE_CSRF_TRUSTED_ORIGINS=https://gemining.duckdns.org

# Racine des données persistantes (doit pointer vers le volume monté).
GE_DATA_ROOT=/data

# --- FACULTATIF -----------------------------------------------------------
# Port interne (Coolify le mappe automatiquement). Défaut : 8000.
# PORT=8000
